# ─────────────────────────────────────────────────────────────────────────────
# CA Firm ERP — docker-compose variable substitution
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` (same directory as docker-compose.yml — Compose loads it
# automatically). These vars are consumed ONLY by docker-compose.yml itself,
# to configure the postgres/redis containers and to build the DATABASE_URL/
# REDIS_* overrides passed into the backend/worker containers.
#
# The application's own runtime configuration (JWT secrets, SMTP, Razorpay,
# storage, ...) is separate — see backend/.env.example and frontend/.env.example.
# `docker-compose.yml` loads `backend/.env` in full via `env_file:`.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=cafirm
POSTGRES_PASSWORD=change-me-to-a-strong-password   # REQUIRED — compose refuses to start without it
POSTGRES_DB=cafirm

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                                     # recommended in production; empty disables auth

# ─── Application ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api/v1                           # build-time only — see frontend/Dockerfile
COMMIT_SHA=                                         # optional — surfaces in GET /health; CI sets this to ${{ github.sha }}
