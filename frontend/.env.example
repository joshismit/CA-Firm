# ─────────────────────────────────────────────────────────────────────────────
# CA Firm ERP — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.development` (local dev, gitignored) or `.env.production.local`
# as needed. `src/config/env.ts` is the only file that reads these directly —
# everything else imports from there.
#
# Vite inlines every VITE_* value into the compiled JS at BUILD time — setting
# these as container/host environment variables at runtime has no effect once
# built. In Docker, `VITE_API_BASE_URL` is a build ARG instead — see
# frontend/Dockerfile.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api/v1
