model Client {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  businessId String @unique @map("business_id") @db.Uuid

  status      ClientStatus @default(ACTIVE)
  onboardedAt DateTime?    @map("onboarded_at") @db.Timestamptz
  categoryId  String?      @map("category_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  business Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category ClientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  assignments ClientAssignment[]
  tags        ClientTagAssignment[]
  conversion  LeadConversion?
  projects    Project[]
  invoices    Invoice[]

  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("clients")
}

model ClientAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  role       String   @db.VarChar(50)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation("ClientAssignedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([tenantId, userId])
  @@map("client_assignments")
}

model ClientCategory {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String  @db.VarChar(100)
  color    String? @db.Char(7)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  clients Client[]

  @@unique([tenantId, name])
  @@map("client_categories")
}

model ClientTag {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(50)

  assignments ClientTagAssignment[]

  @@unique([tenantId, name])
  @@map("client_tags")
}

model ClientTagAssignment {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  tagId    String @map("tag_id") @db.Uuid

  client Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    ClientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([clientId, tagId])
  @@map("client_tag_assignments")
}

// =============================================================================
// SECTION 8 — CRM MODULE
// =============================================================================

model Lead {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  businessId String? @map("business_id") @db.Uuid
  contactId  String? @map("contact_id") @db.Uuid

  title    String @db.VarChar(255)
  sourceId String @map("source_id") @db.Uuid
  stageId  String @map("stage_id") @db.Uuid

  expectedRevenue   Decimal?  @map("expected_revenue") @db.Decimal(12, 2)
  probability       Int?      @map("probability") // 0-100
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid

  business      Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source        LeadSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  stage         LeadStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  deletedByUser User?      @relation("LeadDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  activities  LeadActivity[]
  notes       LeadNote[]
  assignments LeadAssignment[]
  conversion  LeadConversion?

  @@index([tenantId, stageId])
  @@index([tenantId, expectedCloseDate])
  @@index([tenantId, deletedAt])
  @@map("leads")
}

model LeadSource {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(100)

  leads Lead[]

  @@unique([tenantId, name])
  @@map("lead_sources")
}

model LeadStage {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String @db.VarChar(100)
  order    Int    @default(0)

  leads Lead[]

  @@unique([tenantId, name])
  @@index([tenantId, order])
  @@map("lead_stages")
}

model LeadActivity {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid

  type          ActivityType @map("type")
  description   String       @db.Text
  activityDate  DateTime     @default(now()) @map("activity_date") @db.Timestamptz
  performedById String       @map("performed_by_id") @db.Uuid

  lead        Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy User @relation("ActivityPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([leadId, activityDate(sort: Desc)])
  @@map("lead_activities")
}

model LeadNote {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid

  content   String   @db.Text
  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt(sort: Desc)])
  @@map("lead_notes")
}

model LeadAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @map("lead_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation("LeadAssignedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leadId, userId])
  @@index([tenantId, userId])
  @@map("lead_assignments")
}

model LeadConversion {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  leadId   String @unique @map("lead_id") @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  convertedById String   @map("converted_by_id") @db.Uuid
  convertedAt   DateTime @default(now()) @map("converted_at") @db.Timestamptz
  notes         String?  @db.Text

  lead        Lead   @relation(fields: [leadId], references: [id], onDelete: Restrict)
  client      Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  convertedBy User   @relation("LeadConvertedBy", fields: [convertedById], references: [id], onDelete: Restrict)

  @@map("lead_conversions")
}

// =============================================================================
// SECTION 9 — PROJECTS MODULE
// =============================================================================

model Project {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  clientId  String  @map("client_id") @db.Uuid
  managerId String? @map("manager_id") @db.Uuid

  code   String        @db.VarChar(50)
  name   String        @db.VarChar(255)
  status ProjectStatus @default(DRAFT)

  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  deletedBy String?   @map("deleted_by") @db.Uuid

  client        Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  manager       User?  @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdByUser User?  @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  deletedByUser User?  @relation("ProjectDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  tasks         Task[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, dueDate])
  @@index([tenantId, deletedAt])
  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED

  @@map("project_status")
}

// =============================================================================
// SECTION 10 — TASKS MODULE
// =============================================================================
//
// Deliberately minimal, matching the same scope discipline used for Project:
// no TaskAssignment/TaskDependency/TaskLabel satellite tables, and per explicit
// instruction, no milestones, comments, notifications, activities, or time
// tracking. `assigneeId` is a single nullable FK (mirrors Project.managerId)
// rather than a many-to-many assignment join table.

model Task {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  projectId  String? @map("project_id") @db.Uuid
  assigneeId String? @map("assignee_id") @db.Uuid

  title       String     @db.VarChar(255)
  description String?    @db.Text
  status      TaskStatus @default(TODO)

  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  deletedBy String?   @map("deleted_by") @db.Uuid

  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee      User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdByUser User?    @relation("TaskCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  deletedByUser User?    @relation("TaskDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@index([tenantId, assigneeId])
  @@index([tenantId, dueDate])
  @@index([tenantId, deletedAt])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED

  @@map("task_status")
}

// =============================================================================
// SECTION 11 — DOCUMENTS MODULE
// =============================================================================
//
// Deliberately minimal, matching the same scope discipline used for Project/
// Task: a single `Document` metadata table, no DocumentFolder/DocumentShare/
// DocumentTemplate satellite tables, and `version` tracked as a plain
// incrementing Int rather than a full version-history table. Matches
// frontend/src/modules/documents/types/index.ts's `DocumentFile` shape,
// which predates this schema and was marked PROVISIONAL pending backend
// design. `category` is a fixed enum (mirrors the frontend's
// DOCUMENT_CATEGORY_VALUES) rather than a tenant-configurable table like
// BusinessType/ClientCategory — no signal that firms need custom categories.

model Document {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  businessId String? @map("business_id") @db.Uuid
  contactId  String? @map("contact_id") @db.Uuid

  category   DocumentCategory
  fileName   String           @map("file_name") @db.VarChar(255)
  storageKey String           @unique @map("storage_key") @db.VarChar(500)
  mimeType   String           @map("mime_type") @db.VarChar(150)
  sizeBytes  Int              @map("size_bytes")
  version    Int              @default(1)

  uploadedById String @map("uploaded_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid

  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  uploadedBy    User      @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedByUser User?     @relation("DocumentDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, category])
  @@index([tenantId, businessId])
  @@index([tenantId, contactId])
  @@index([tenantId, deletedAt])
  @@index([fileName(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("documents")
}

enum DocumentCategory {
  PAN
  GST
  INCOME_TAX
  ROC
  AUDIT
  BANK
  AGREEMENTS
  PAYROLL
  DSC
  IDENTITY
  OTHER

  @@map("document_category")
}

// =============================================================================
// SECTION 12 — COMPLIANCE MODULE
// =============================================================================
//
// One generic `ComplianceFiling` table shared by all four Compliance areas
// (GST/ITR/TDS/MCA), discriminated by `category` — matches
// frontend/src/modules/compliance/types/index.ts's `ComplianceFiling`
// exactly: a deliberately generic "filing tracker" shape (reference/period/
// status/dueDate/filedDate/notes), not four real domain-specific schemas
// (no gstin/assessmentYear/form26Q), per that file's own header comment
// ("this generic type should be split into four real, module-specific ones"
// once real per-area requirements exist). `tenantId` is a plain scalar
// column with no `@relation`/FK to `Tenant`, mirroring `Contact`'s identical
// pattern (tenant scoping enforced at the application layer via
// `BaseRepository`, not a DB-level foreign key). No `createdBy`/`deletedBy`
// columns — the frontend's response type never reads a creator/deleter, and
// nothing else in this module needs one.
//
// `status`/`filedDate` are stored but not exposed as user-settable in either
// `CreateComplianceFilingPayload` or `UpdateComplianceFilingPayload` (the
// frontend form never collects them) — every filing is created as DRAFT and
// stays that way via this API. See the Compliance module's final report for
// this known limitation.

model ComplianceFiling {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  category ComplianceCategory @map("category")

  reference String                 @map("reference") @db.VarChar(100)
  period    String                 @map("period") @db.VarChar(50)
  status    ComplianceFilingStatus @default(DRAFT) @map("status")
  dueDate   DateTime?              @map("due_date") @db.Timestamptz
  filedDate DateTime?              @map("filed_date") @db.Timestamptz
  notes     String?                @map("notes") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@index([tenantId, category, status], name: "idx_compliance_tenant_category_status")
  @@index([tenantId, category, deletedAt], name: "idx_compliance_soft_delete")
  @@index([reference(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("compliance_filings")
}

enum ComplianceCategory {
  GST
  ITR
  TDS
  MCA

  @@map("compliance_category")
}

enum ComplianceFilingStatus {
  DRAFT
  PENDING
  FILED
  OVERDUE

  @@map("compliance_filing_status")
}

// =============================================================================
// SECTION 13 — CLIENT BILLING MODULE
// =============================================================================
//
// Three generic tables — `Invoice`, `Expense`, `Payment` — matching
// frontend/src/modules/client-billing/types/index.ts exactly. This is the
// firm's client-facing billing (invoices issued to / expenses incurred for
// its own clients) — a completely separate domain from the tenant's own
// SaaS-subscription billing to the ERP vendor (frontend/src/modules/billing,
// which has no backend model at all yet and must not be touched here).
//
// Deliberately minimal, matching the same scope discipline as Compliance:
// no ledger, no journal entries, no tax engine, no payment gateway, no
// invoice-numbering engine, no PDF/email generation, no account balances.
// `clientId`/`businessId`/`invoiceId` are real FKs (for referential
// integrity, `onDelete: SetNull` mirrors `Document`'s identical pattern for
// optional business/contact references) but the API never exposes a nested
// Client/Business/Invoice object or a lookup endpoint — only the raw ID
// string, matching the frontend's own plain-UUID-input `InvoiceForm`/
// `PaymentForm` exactly. `status` is stored with a sensible default but not
// user-settable via create/update — none of the three forms collect one, so
// (like Compliance) there is no status-transition endpoint to build.

model Invoice {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  invoiceNumber String  @map("invoice_number") @db.VarChar(50)
  clientId      String? @map("client_id") @db.Uuid
  businessId    String? @map("business_id") @db.Uuid

  amount     Decimal       @db.Decimal(14, 2)
  tax        Decimal       @default(0) @db.Decimal(14, 2)
  issuedDate DateTime?     @map("issued_date") @db.Timestamptz
  dueDate    DateTime?     @map("due_date") @db.Timestamptz
  status     InvoiceStatus @default(DRAFT)
  notes      String?       @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@unique([tenantId, invoiceNumber], name: "uq_invoices_tenant_number")
  @@index([tenantId, status], name: "idx_invoices_tenant_status")
  @@index([tenantId, clientId], name: "idx_invoices_tenant_client")
  @@index([tenantId, businessId], name: "idx_invoices_tenant_business")
  @@index([tenantId, deletedAt], name: "idx_invoices_soft_delete")
  @@index([invoiceNumber(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("invoices")
}

model Expense {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  expenseNumber String  @map("expense_number") @db.VarChar(50)
  category      String  @db.VarChar(100)
  vendor        String? @db.VarChar(255)

  amount        Decimal       @db.Decimal(14, 2)
  date          DateTime?     @db.Timestamptz
  paymentMethod String?       @map("payment_method") @db.VarChar(50)
  status        ExpenseStatus @default(DRAFT)
  notes         String?       @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([tenantId, expenseNumber], name: "uq_expenses_tenant_number")
  @@index([tenantId, status], name: "idx_expenses_tenant_status")
  @@index([tenantId, category], name: "idx_expenses_tenant_category")
  @@index([tenantId, deletedAt], name: "idx_expenses_soft_delete")
  @@index([expenseNumber(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("expenses")
}

model Payment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  paymentNumber String  @map("payment_number") @db.VarChar(50)
  invoiceId     String? @map("invoice_id") @db.Uuid

  amount    Decimal       @db.Decimal(14, 2)
  method    String?       @db.VarChar(50)
  reference String?       @db.VarChar(100)
  paidDate  DateTime?     @map("paid_date") @db.Timestamptz
  status    PaymentStatus @default(PENDING)
  notes     String?       @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, paymentNumber], name: "uq_payments_tenant_number")
  @@index([tenantId, status], name: "idx_payments_tenant_status")
  @@index([tenantId, invoiceId], name: "idx_payments_tenant_invoice")
  @@index([tenantId, deletedAt], name: "idx_payments_soft_delete")
  @@index([paymentNumber(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("payments")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID

  @@map("invoice_status")
}

enum ExpenseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAID

  @@map("expense_status")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@map("payment_status")
}

// =============================================================================
// SECTION 14 — NOTIFICATIONS MODULE
// =============================================================================
//
// Matches frontend/src/modules/notifications/types/index.ts exactly. Deliberately
// minimal — no template/provider/preference/scheduling/topic/subscription tables.
// Notifications are system-generated (some future module inserts rows directly);
// this module only ever reads, marks-read, and deletes — there is no create
// endpoint. `userId` is a real FK (`onDelete: Cascade` — a deleted user's
// notifications have no reason to remain), unlike `tenantId` on most other
// models in this schema, because ownership (not just tenant membership) is the
// core access-control dimension here: every query is scoped by `(tenantId,
// userId)` together, enforced in the service layer since `BaseRepository` only
// has built-in tenant/soft-delete scoping.

model Notification {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)
  title   String              @db.VarChar(255)
  message String              @db.Text
  isRead  Boolean             @default(false) @map("is_read")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead], name: "idx_notifications_user_unread")
  @@index([tenantId, userId, status], name: "idx_notifications_user_status")
  @@index([tenantId, userId, createdAt], name: "idx_notifications_user_created")
  @@index([tenantId, userId, deletedAt], name: "idx_notifications_soft_delete")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("notifications")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS
  IN_APP

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED

  @@map("notification_status")
}

// =============================================================================
// SECTION 15 — MASTER ADMIN MODULE
// =============================================================================
//
// Platform-level admin account — deliberately NOT a `User` row (a `User` is
// always tenant-scoped via the required `tenantId` FK; a master admin manages
// every tenant, so it can't belong to one). No self-service signup: rows are
// created only by `prisma/seeds/master-admin.seed.ts` from the
// `MASTER_ADMIN_EMAIL`/`MASTER_ADMIN_PASSWORD` env vars. No session/refresh-
// token table of its own — `UserSession`/`RefreshToken` FK to `User.id`, which
// this isn't — so master admin auth is access-token-only (see
// `modules/master-admin/service/master-admin-auth.service.ts`'s header
// comment); a lapsed token just means logging in again.

model MasterAdmin {
  id String @id @default(uuid()) @db.Uuid

  email        String  @unique @db.VarChar(255)
  passwordHash String  @map("password_hash") @db.Text
  firstName    String  @map("first_name") @db.VarChar(100)
  lastName     String  @map("last_name") @db.VarChar(100)
  isActive     Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("master_admins")
}
