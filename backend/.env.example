# ─────────────────────────────────────────────────────────────────────────────
# CA Firm ERP — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values. Every variable below is validated by
# `src/config/environment.ts` at process startup (the ONLY place process.env
# is read) — the server refuses to start if a required one is missing or
# malformed. Never commit a real `.env`; this file contains no secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ───────────────────────────────────────────────────────────
NODE_ENV=development                      # development | staging | production | test
APP_NAME=CAFirmERP
APP_PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
API_PREFIX=/api/v1
APP_VERSION=1.0.0                         # mirrors package.json's version — shown by GET /health
COMMIT_SHA=                               # optional — injected by CI/Docker build, not set by hand locally

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cafirm:password@localhost:5432/cafirm   # REQUIRED

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars-long   # REQUIRED, min 32 chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-32-chars-min  # REQUIRED, min 32 chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Master Admin ──────────────────────────────────────────────────────────
# Platform-level (cross-tenant) admin login — see modules/master-admin. Optional,
# but nothing else can create the first master admin account without it.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# ─── Redis ─────────────────────────────────────────────────────────────────
# Used for caching, rate limiting, and as the BullMQ (email/notification/report/
# audit/document-processing queue) connection.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── SMTP (Mail) ────────────────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@cafirm.com
MAIL_FROM_NAME=CA Firm ERP

# ─── Storage (AWS S3 / Cloudflare R2) ──────────────────────────────────────
STORAGE_PROVIDER=local                    # local | s3 | r2
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_ENDPOINT_URL=                         # only for Cloudflare R2 (S3-compatible endpoint)

# ─── Razorpay (platform subscription billing) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                  # configured in the Razorpay dashboard against a public webhook URL

# ─── Client Payment Gateway (firm-owned client payment collection) ─────────
# 32 random bytes, hex-encoded (64 hex chars) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_GATEWAY_ENCRYPTION_KEY=

# ─── WhatsApp (notification channel) ───────────────────────────────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_SENDER_ID=

# ─── SMS (notification channel) ────────────────────────────────────────────
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ─── White Label ────────────────────────────────────────────────────────────
# The platform's own base domain — a tenant's white-label URL is
# `<subdomain>.<PLATFORM_DOMAIN>`. Per-tenant branding (logo, colors, custom
# domain) itself is stored in the database, not here — see modules/tenant.
PLATFORM_DOMAIN=localhost

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info                            # trace | debug | info | warn | error | fatal

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000               # 15 minutes
RATE_LIMIT_MAX=100

# ─── Swagger ────────────────────────────────────────────────────────────────
ENABLE_SWAGGER=true                       # recommend false in production
